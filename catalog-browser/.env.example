# Catalog Browser — copie para .env e preencha os valores.
# Backend (FastAPI) — conexão Databricks
DATABRICKS_HOST=https://fevm-leticia-demo-catalog.cloud.databricks.com
DATABRICKS_TOKEN=

# Prefixo dos catálogos a listar (default: leticia_demo_catalog → mostra leticia_demo_catalog_catalog)
CATALOG_PREFIX=leticia_demo_catalog

# Opcional: URL do backend para o frontend em build de produção.
# Em desenvolvimento o Vite faz proxy para http://127.0.0.1:8000.
# VITE_API_URL=http://localhost:8000
