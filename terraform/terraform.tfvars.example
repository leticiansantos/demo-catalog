# Copie para terraform.tfvars e preencha com o seu workspace.
# Para mudar de workspace no futuro: edite terraform.tfvars e reaplique.

workspace_id    = "SEU_WORKSPACE_ID"
workspace_name  = "nome-do-workspace"
environment     = "demo"
databricks_host = "https://SEU-SUBDOMAIN.cloud.databricks.com"

# Só necessário para criar os catálogos Motiva (Default Storage sem metastore root):
# enable_motiva_synthetic_catalogs = true
# motiva_catalog_storage_root     = "s3://SEU_BUCKET/uc/motiva"
